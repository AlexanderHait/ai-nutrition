      "parameters": {
        "jsCode": "const input=$items('When Executed by Another Workflow')[0].json,c=$json.context||{},pr=c.preferences||{};if(pr.post_meal_insights===false)return[];const s=c.settings||{},T=c.today?.eaten||{},n=v=>Number(v||0),kt=n(s.kcal_target),pt=n(s.protein_target),ft=n(s.fat_target);let text='';if(kt&&n(T.kcal)>kt*1.05)text='💡 *Контекст дня*\\nКалорийная цель уже закрыта. Дальше ориентируйся прежде всего на голод; если нужен ещё приём — лучше сделать его лёгким.';else if(ft&&n(T.fat)>ft*1.05)text='💡 *Контекст дня*\\nЖиры на сегодня уже практически закрыты. В следующем приёме лучше выбрать более постный белок.';else if(pt&&n(T.prot)>=pt*.85)text='💡 *Хороший темп*\\nБелок уже почти закрыт. Следующий приём можно выбирать свободнее по оставшимся калориям и углеводам.';else if(n(input.prot)>=30)text=`💡 *Хороший основной приём*\\nВ этом приёме около ${Math.round(n(input.prot))} г белка — хороший вклад в дневную цель.`;if(!text)return[];return[{json:{chat_id:Number(input.chat_id),text}}];"
