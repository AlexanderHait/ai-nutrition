          "id": "gQAneJwyj5J76uTe",
          "name": "OpenRoute"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 600,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const src=$items('Prepare Weekly Context'),out=items;return out.map((o,i)=>{const j=o.json||{};let t=j.output_text||j.output||j.text||j.content||j.message?.content||j.choices?.[0]?.message?.content||'';if(Array.isArray(t))t=t.map(x=>x?.text||x?.content||x).join('\\n');const c=JSON.parse(src[i]?.json.context||'{}'),s=c.settings||{},q=c.data_quality||{},wt=c.weight_trend||{},n=v=>Number(v||0);let proposal=null;if(q.level==='high'&&n(s.kcal_target)>0&&wt.delta!=null){const dw=n(wt.delta),g=String(s.goal||'').toLowerCase();if((g.includes('gain')||g.includes('набор'))&&dw<=0.1)proposal={current_kcal:n(s.kcal_target),proposed_kcal:n(s.kcal_target)+150,reason:'При хорошем качестве данных сглаженный тренд веса почти не растёт. Можно протестировать +150 ккал.'};else if((g.includes('loss')||g.includes('сниж')||g.includes('похуд'))&&dw>=-0.1)proposal={current_kcal:n(s.kcal_target),proposed_kcal:Math.max(1200,n(s.kcal_target)-150),reason:'При хорошем качестве данных сглаженный тренд веса почти не снижается. Можно протестировать -150 ккал.'}}return{json:{chat_id:src[i]?.json.chat_id,week_end:src[i]?.json.week_end,text:String(t||'').trim(),proposal}}});"
      },
