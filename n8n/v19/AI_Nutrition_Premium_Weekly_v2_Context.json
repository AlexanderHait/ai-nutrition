      "parameters": {
        "jsCode": "const now=new Date();const wd=new Intl.DateTimeFormat('en-US',{timeZone:'Europe/Moscow',weekday:'short'}).format(now);if(wd!=='Sun')return [];let a=$json;if(a?.body)a=a.body;if(a?.data)a=a.data;if(!Array.isArray(a))a=items.map(i=>i.json).flatMap(x=>Array.isArray(x)?x:[]);const week_end=new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Moscow'}).format(now);return a.filter(x=>x?.chat_id&&x.context?.preferences?.weekly_review!==false).map(x=>({json:{chat_id:Number(x.chat_id),week_end,context:JSON.stringify(x.context)}}));"
