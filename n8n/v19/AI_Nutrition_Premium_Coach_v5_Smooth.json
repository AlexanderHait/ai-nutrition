      "parameters": {
        "jsCode": "\nconst j=$json,c=j.context||{},cmd=String(j.command||'recommend'),raw=String(j.message?.text||j.raw||'');\nconst sub=c.subscription||{},life=c.subscription_lifecycle||{};\nconst legacyPremium=sub.plan==='premium'&&sub.status==='active'&&(!sub.ends_at||new Date(sub.ends_at)>new Date());\nconst lifecyclePremium=life.plan==='premium'&&['trial','active','grace'].includes(String(life.state||''))&&(!life.current_period_end||new Date(life.current_period_end)>new Date()||life.state==='grace');\nconst premium=legacyPremium||lifecyclePremium;\nconst medical_query=/\\b(давлен|беремен|анорекс|булим|рпп|лекар|препарат|таблет|диабет|инсулин|болит|головокруж|обморок|сердц|почек|почки|печен|анеми|ферритин|гемоглобин)\\w*/i.test(raw);if(!premium)return[{json:{...j,blocked:true,scenario:'',user_request:raw,prompt:''}}];\nconst scenarios={recommend:'Определи лучший следующий шаг по питанию прямо сейчас.',plan:'Составь план оставшегося дня.',shop:'Пользователь в магазине: собери конкретную корзину.',restaurant:'Пользователь в ресторане: предложи 3 типа заказа.',quick:'Нет времени готовить: 3 быстрых решения.',sweet:'Пользователь хочет сладкое: встрои десерт в день.',training:'Сегодня тренировка: предложи питание без выдумывания типа тренировки.',overate:'Пользователь переел: скорректируй остаток дня без наказаний.',bedtime:'Подбери уместный вариант перед сном.',can:'Оцени продукт из сообщения пользователя.',why:'Объясни последнюю рекомендацию простыми словами, опираясь на факты контекста.'};\nreturn[{json:{...j,medical_query,started_at_ms:Date.now(),scenario:scenarios[cmd]||scenarios.recommend,user_request:raw,prompt:JSON.stringify({scenario:scenarios[cmd]||scenarios.recommend,user_request:raw,context:c},null,2)}}];\n"
