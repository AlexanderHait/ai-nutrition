    {
      "parameters": {
        "jsCode": "const src=$items('Prepare Knowledge')[0].json;let raw=$json.output_text||$json.output||$json.text||$json.content||$json.message?.content||$json.choices?.[0]?.message?.content||'';if(Array.isArray(raw))raw=raw.map(x=>x?.text||x?.content||x).join('\\n');raw=String(raw).replace(/```json|```/g,'').trim();let j={};try{j=JSON.parse(raw)}catch{};return (Array.isArray(j.items)?j.items:[]).slice(0,15).map(x=>({json:{job_id:src.job_id,source_id:src.source_id,topic:String(x.topic||'other'),claim:String(x.claim||''),practical_rule:String(x.practical_rule||''),audience:String(x.audience||''),caveat:String(x.caveat||''),tags:Array.isArray(x.tags)?x.tags:[]}})).filter(i=>i.json.claim);"
      },
