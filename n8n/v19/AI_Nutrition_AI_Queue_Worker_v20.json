      "parameters": {
        "jsCode": "const p=$json.payload||{},input=p.input||{};const kind=input?._ingress?.kind||(input.callback_query?'callback':input.message?.photo?.length?'photo':'text');const text=String(input.message?.text||'');const command=text.startsWith('/')?text.split(/\\s+/)[0].toLowerCase():null;const cb=String(input.callback_query?.data||'');return[{json:{job_id:$json.id,replay_event_id:Number(p.replay_event_id||0),diagnostic:{kind,command,callback_data:cb||null,has_photo:Boolean(input.message?.photo?.length),has_caption:Boolean(input.message?.caption),chat_id:input._ingress?.chat_id||input.message?.chat?.id||input.callback_query?.message?.chat?.id||null,route:kind==='text'?'tx_text':(kind==='photo'||kind==='callback'?'callbacks':'unsupported')}}}];"
      },
