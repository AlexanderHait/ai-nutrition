      "parameters": {
        "jsCode": "let a=$json;if(a?.body)a=a.body;if(a?.data)a=a.data;if(!Array.isArray(a))a=items.map(i=>i.json).flatMap(x=>Array.isArray(x)?x:[]);\nconst tz='Europe/Moscow',hour=Number(new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',hour12:false}).format(new Date())),today=new Intl.DateTimeFormat('sv-SE',{timeZone:tz}).format(new Date()),n=v=>Number(v||0);\nconst out=[];for(const x of a){const c=x.context||{},pr=c.preferences||{},ad=c.adaptive_coach||{};\nif(pr.smart_nudges===false||pr.notification_level==='minimal')continue;\nif(pr.notification_level==='normal'&&hour<17)continue;\nconst best=Array.isArray(ad.best_contact_hours)?ad.best_contact_hours.map(Number).filter(Number.isFinite):[];\nif(best.length&&Math.min(...best.map(h=>Math.abs(h-hour)))>2&&pr.notification_level!=='active')continue;\nconst s=c.settings||{},T=c.today?.eaten||{},kt=n(s.kcal_target),pt=n(s.protein_target),pace=c.today?.pacing||{};let text='',type='';\nif(pace.status==='on_track'&&n(T.meals)>0&&(!pt||n(T.prot)>=pt*.75))continue;if(n(T.meals)===0){type='no_food';text='🌙 *Небольшое напоминание*\\n\\nСегодня питание ещё не записано. Если уже ел — пришли фото или внеси день через /day.'}else if(kt&&n(T.kcal)<kt*.58){type='large_gap';text=`🍽 *На вечер остался большой объём*\\n\\nСейчас записано ~${Math.round(n(T.kcal))} из ${Math.round(kt)} ккал. Лучше сделать полноценный приём сейчас, чем оставлять всё на поздний вечер.`}else if(pt&&n(T.prot)<pt*.65){type='protein_gap';text=`🥩 *Белок сегодня отстаёт*\\n\\nСейчас ~${Math.round(n(T.prot))} из ${Math.round(pt)} г. В следующем приёме сделай белковый продукт основой.`}if(text)out.push({json:{chat_id:Number(x.chat_id),for_date:today,nudge_type:type,text}})}return out;"
