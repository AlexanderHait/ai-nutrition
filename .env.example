# Переменные окружения TeddY
#
# Это образец, а не рабочий файл. Секретов здесь нет и быть не должно.
# Значения задаются в Vercel: проект ai-nutrition -> Settings -> Environment Variables.
# После изменения переменных нужен редеплой — на лету Vercel их не подхватывает.
#
# Заполнено = вписывай как есть. Пусто = бери значение в личном кабинете сервиса.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Адрес проекта nutri. В коде есть такое же значение по умолчанию.
NEXT_PUBLIC_SUPABASE_URL=https://asgcofyqfflpvchhgtph.supabase.co

# Публичный ключ для браузера. Supabase -> Settings -> API Keys -> publishable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# СЕКРЕТ. Полный доступ к базе в обход RLS. Только на сервере, никому не показывать.
# Supabase -> Settings -> API Keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Сайт и сессии
# ---------------------------------------------------------------------------

# Базовый адрес сайта. Используется для ссылок возврата после оплаты и для Telegram OAuth.
NEXT_PUBLIC_SITE_URL=https://smartnutrition-ai.ru

# СЕКРЕТ. Ключ подписи cookies сессии. Длинная случайная строка.
# Сгенерировать: openssl rand -base64 48
# Если поменять — все пользователи разлогинятся.
SESSION_SECRET=

# СЕКРЕТ. Пароль входа в административную панель.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# СЕКРЕТ. Токен бота TeddyRIZ_bot от @BotFather.
# Нужен для рассылок и загрузки аватарок клиентов.
TELEGRAM_BOT_TOKEN=

# ID и секрет приложения Telegram для входа на сайт через Telegram OAuth.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Оплата — ЮKassa
# ---------------------------------------------------------------------------

# Номер магазина в ЮKassa.
YOOKASSA_SHOP_ID=1424467

# СЕКРЕТ. Секретный ключ ЮKassa.
# ЛК ЮKassa -> Настройки -> Ключи API. Живёт только в Vercel.
YOOKASSA_SECRET_KEY=

# Чеки 54-ФЗ. При true поле почты на странице оплаты становится обязательным.
YOOKASSA_RECEIPTS_ENABLED=true

# Ставка НДС для чека. 1 = без НДС.
# Коды: 1 без НДС, 2 НДС 0%, 3 НДС 10%, 4 НДС 20%, 5 НДС 10/110, 6 НДС 20/120.
YOOKASSA_VAT_CODE=1

# Признак предмета и способа расчёта в чеке. Значения по умолчанию заданы в коде.
YOOKASSA_PAYMENT_SUBJECT=service
YOOKASSA_PAYMENT_MODE=full_payment

# ---------------------------------------------------------------------------
# Связь с n8n и служебное
# ---------------------------------------------------------------------------

# СЕКРЕТ. Значение заголовка Authorization для вызова вебхуков n8n с сайта.
N8N_WEBHOOK_AUTHORIZATION=

# СЕКРЕТ. Общий ключ, которым n8n подписывает обращения к /api/bot/usage.
N8N_USAGE_SECRET=

# СЕКРЕТ. Ключ подписи запросов бота к /api/bot/*.
BOT_INGEST_SECRET=

# СЕКРЕТ. Ключ для запуска задания рассылок по расписанию: /api/cron/mailings.
# Передаётся как заголовок Authorization: Bearer <значение>.
CRON_SECRET=
